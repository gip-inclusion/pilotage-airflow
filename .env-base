AIRFLOW__CORE__DEFAULT_POOL_TASK_SLOT_COUNT=24
AIRFLOW__CORE__DEFAULT_TIMEZONE=Europe/Paris
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__PARALLELISM=6
AIRFLOW__SCHEDULER__CATCHUP_BY_DEFAULT=False
AIRFLOW__SCHEDULER__CREATE_CRON_DATA_INTERVALS=False
AIRFLOW__SCHEDULER__CREATE_DELTA_DATA_INTERVALS=False
# Airflow 3 defaults to the SimpleAuthManager, which has no user management.
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
# The FAB provider serves the UI login, both options moved to its own section in Airflow 3.
AIRFLOW__FAB__AUTH_BACKENDS="airflow.providers.fab.auth_manager.api.auth.backend.basic_auth,airflow.providers.fab.auth_manager.api.auth.backend.session"
AIRFLOW__FAB__ENABLE_PROXY_FIX=True

SQLALCHEMY_SILENCE_UBER_WARNING=1

AIRFLOW__CORE__DAGS_FOLDER=dags

AIRFLOW_HOME="/tmp/airflow"
DBT_LOG_PATH=".dbt/logs"
DBT_TARGET_PATH=".dbt/target"

AIRFLOW_BASE_DIR="."
PYTHONPATH="${PYTHONPATH}:."
